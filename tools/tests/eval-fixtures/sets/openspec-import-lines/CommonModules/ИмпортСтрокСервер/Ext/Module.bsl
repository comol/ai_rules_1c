#Область ПрограммныйИнтерфейс

// Загружает строки CSV-файла в табличную часть Товары заказа.
//
// Параметры:
//  Заказ - ДокументОбъект.ЗаказКлиента - изменяемый заказ.
//  ТекстФайла - Строка - содержимое файла.
//
// Возвращаемое значение:
//  Структура - Загружено (Число), Пропущено (Массив из Строка), Ошибка (Строка).
//
Функция ЗагрузитьСтроки(Заказ, ТекстФайла) Экспорт

	Результат = Новый Структура("Загружено, Пропущено, Ошибка", 0, Новый Массив, "");
	Строки = РазобратьФайл(ТекстФайла, Результат.Ошибка);
	Если Строки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ДанныеСтроки Из Строки Цикл
		Если Заказ.Товары.НайтиСтроки(Новый Структура("Номенклатура", ДанныеСтроки.Номенклатура)).Количество() > 0 Тогда
			Результат.Пропущено.Добавить(Строка(ДанныеСтроки.Номенклатура));
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Заказ.Товары.Добавить(), ДанныеСтроки);
		Результат.Загружено = Результат.Загружено + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьФайл(ТекстФайла, ТекстОшибки)

	Строки = Новый Массив;
	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстФайла) Цикл
		Части = СтрРазделить(СтрПолучитьСтроку(ТекстФайла, НомерСтроки), ";");
		Если Части.Количество() <> 3 Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Строка %1: ожидается три колонки'"), НомерСтроки);
			Возврат Неопределено;
		КонецЕсли;
		Строки.Добавить(Новый Структура("Номенклатура, Количество, Цена",
			Справочники.Номенклатура.НайтиПоНаименованию(Части[0], Истина), Число(Части[1]), Число(Части[2])));
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти
