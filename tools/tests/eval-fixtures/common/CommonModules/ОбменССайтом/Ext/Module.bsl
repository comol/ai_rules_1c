#Область ПрограммныйИнтерфейс

// Выгружает заказ клиента на сайт.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказКлиента - выгружаемый заказ.
//
Процедура ВыгрузитьЗаказ(Заказ) Экспорт

	Данные = ДанныеЗаказаДляВыгрузки(Заказ);
	ОтправитьНаСайт(Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеЗаказаДляВыгрузки(Заказ)

	Данные = Новый Структура;
	Данные.Вставить("Номер", Заказ.Номер);
	Данные.Вставить("Дата", Заказ.Дата);
	Данные.Вставить("Сумма", Заказ.СуммаДокумента);
	Возврат Данные;

КонецФункции

Процедура ОтправитьНаСайт(Данные)

	Соединение = Новый HTTPСоединение("shop.example.ru", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос("/api/orders");
	Запрос.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Данные));
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сайт вернул код %1'"), Ответ.КодСостояния);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
