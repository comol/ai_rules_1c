#Область ПрограммныйИнтерфейс

// Проверяет корректность ИНН контрагента.
//
// Параметры:
//  ИНН - Строка - проверяемый ИНН.
//
// Возвращаемое значение:
//  Булево - Истина, если ИНН корректен.
//
Функция ПроверитьИНН(ИНН) Экспорт

	Если СтрДлина(ИНН) = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ИНН);

КонецФункции

#КонецОбласти
