#Область ПрограммныйИнтерфейс

// Возвращает склад по умолчанию для организации.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация.
//
// Возвращаемое значение:
//  СправочникСсылка.Склады - склад по умолчанию.
//
Функция ПолучитьСкладПоУмолчанию(Организация) Экспорт

	Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ОсновнойСклад");
	Возврат Склад;

КонецФункции

#КонецОбласти
